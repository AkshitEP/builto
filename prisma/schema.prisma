// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// NextAuth.js required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// User model with plan & usage tracking
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  
  // Subscription & Usage
  plan          Plan      @default(FREE)
  promptsUsed   Int       @default(0)
  promptsLimit  Int       @default(50)
  billingCycle  DateTime  @default(now())
  stripeCustomerId String? @unique
  stripeSubscriptionId String? @unique
  
  // Relations
  accounts      Account[]
  sessions      Session[]
  projects      Project[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Subscription plans
enum Plan {
  FREE
  PRO
  TEAM
}

// User projects (startup ideas)
model Project {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  status      String   @default("pending")
  
  // Agent outputs stored as JSON
  validatorOutput  Json?
  plannerOutput    Json?
  techOutput       Json?
  businessOutput   Json?
  developerOutput  Json?
  
  // Generated code files
  generatedCode    Json?
  
  // Tracking
  promptsUsed      Int      @default(0)
  
  // Relations
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([userId])
}
